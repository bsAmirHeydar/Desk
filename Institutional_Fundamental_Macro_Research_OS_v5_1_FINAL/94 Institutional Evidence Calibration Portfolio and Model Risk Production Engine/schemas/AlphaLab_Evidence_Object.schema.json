{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab Evidence Object V16.1",
  "type": "object",
  "required": [
    "evidence_id",
    "root_cause_id",
    "retrieved_at",
    "source_id",
    "observability_class",
    "model_visible_at_analysis_time",
    "decision_materiality",
    "decision_role"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "root_cause_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_time": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_seen_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "revision_state": {
      "enum": [
        "FIRST_RELEASE",
        "REVISED",
        "TENTATIVE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "url_or_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_snapshot_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "parser_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_visible_at_analysis_time": {
      "type": "boolean"
    },
    "observability_class": {
      "enum": [
        "OBSERVED",
        "OFFICIAL_FIRST_RELEASE",
        "MARKET_IMPLIED",
        "PUBLIC_PROXY",
        "MODEL_IMPLIED",
        "STRUCTURED_JUDGMENT",
        "UNAVAILABLE",
        "UNDETERMINED"
      ]
    },
    "decision_materiality": {
      "enum": [
        "DECISION_CRITICAL",
        "MATERIAL_SECONDARY",
        "CONTEXTUAL"
      ]
    },
    "decision_role": {
      "enum": [
        "DIRECTION_ROOT",
        "TRANSMISSION_CONFIRMATION",
        "TIMING_CLEARANCE",
        "INVALIDATION",
        "CONTRADICTION",
        "CONTEXT"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
