{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab Event FastPath Pack V16.1",
  "type": "object",
  "required": [
    "event_id",
    "event_time_utc",
    "prepared_at_utc",
    "consensus_vintage_utc",
    "scenario_tree",
    "surprise_dimensions",
    "causal_leaders",
    "required_cross_assets",
    "invalidations",
    "source_ids",
    "pack_sha256"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "prepared_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "consensus_vintage_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_tree": {
      "type": "array",
      "minItems": 1
    },
    "surprise_dimensions": {
      "type": "array",
      "minItems": 1
    },
    "causal_leaders": {
      "type": "array",
      "minItems": 1
    },
    "required_cross_assets": {
      "type": "array"
    },
    "invalidations": {
      "type": "array"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1
    },
    "max_pack_age_seconds": {
      "type": "number",
      "minimum": 0
    },
    "pack_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "release_update": {
      "type": [
        "object",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
