{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab D1 Decision Evidence Pack",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "symbol",
    "analysis_cutoff_utc",
    "manifest_version",
    "fact_records",
    "coverage_receipt",
    "future_vintages_excluded"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "symbol": {
      "enum": [
        "XAUUSD",
        "NASDAQ100",
        "SP500",
        "DJIA",
        "EURUSD",
        "USDJPY"
      ]
    },
    "analysis_cutoff_utc": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_version": {
      "type": "string",
      "enum": [
        "17.0.0",
        "18.0.0",
        "19.0.0",
        "20.0.0",
        "21.0.0",
        "21.1.0",
        "21.2.0"
      ],
      "description": "Runtime stack version at the decision cutoff. The D1 schema itself is versioned separately."
    },
    "fact_records": {
      "type": "array",
      "items": {
        "$ref": "AlphaLab_Fact_Record.schema.json"
      }
    },
    "decision_critical_unknowns": {
      "type": "array"
    },
    "root_dependencies": {
      "type": "array"
    },
    "coverage_receipt": {
      "type": "object"
    },
    "future_vintages_excluded": {
      "const": true
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "runtime_stack_version": {
      "type": "string",
      "enum": [
        "17.0.0",
        "18.0.0",
        "19.0.0",
        "20.0.0",
        "21.0.0",
        "21.1.0",
        "21.2.0"
      ]
    }
  }
}
