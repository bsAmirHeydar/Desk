{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "instrument",
    "items",
    "private_gap_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "instrument": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "private_gap_policy": {
      "const": "EXPLICIT_NO_PROXY_SUBSTITUTION"
    }
  },
  "additionalProperties": false
}
