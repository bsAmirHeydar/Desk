{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "roots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "channels"
        ],
        "properties": {
          "root_id": {
            "type": "string"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
