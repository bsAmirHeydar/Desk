{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "verified_fact_ids",
    "verified_root_ids",
    "decision_critical_gaps",
    "same_root_double_count_found",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "PASS",
        "CONSTRAINED",
        "FAIL"
      ]
    },
    "verified_fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_root_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_critical_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "same_root_double_count_found": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
