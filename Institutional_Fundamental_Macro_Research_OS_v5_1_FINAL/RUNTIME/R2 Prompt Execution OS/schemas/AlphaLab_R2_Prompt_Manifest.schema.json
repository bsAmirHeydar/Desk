{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "process_id",
    "version",
    "stage",
    "prompt_path",
    "dependencies",
    "outputs",
    "model_profile",
    "authority",
    "forbidden_inputs"
  ],
  "properties": {
    "process_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "prompt_path": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "model_profile": {
      "type": "string"
    },
    "canonical_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "object"
    },
    "independence_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_semantics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation_policy": {
      "type": "string"
    },
    "context_mode": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
