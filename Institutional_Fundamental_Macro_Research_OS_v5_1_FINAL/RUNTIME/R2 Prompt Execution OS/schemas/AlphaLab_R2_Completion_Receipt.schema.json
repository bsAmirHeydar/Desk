{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "gates",
    "epistemic_completion",
    "decision_seal_ready",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "CONSTRAINED"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "epistemic_completion": {
      "type": "boolean"
    },
    "decision_seal_ready": {
      "type": "boolean"
    },
    "created_at_utc": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
