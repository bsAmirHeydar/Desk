{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "groups": {
      "items": {
        "properties": {
          "dependency_type": {
            "enum": [
              "INDEPENDENT_ROOT",
              "COMMON_ROOT",
              "COMMON_DATASET",
              "SYNDICATED",
              "TRANSFORMED_COPY",
              "MODEL_DERIVATION",
              "UNKNOWN"
            ]
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "root_id": {
            "type": "string"
          }
        },
        "required": [
          "root_id",
          "evidence_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "independent_root_count": {
      "minimum": 0,
      "type": "integer"
    },
    "nominal_count": {
      "minimum": 0,
      "type": "integer"
    },
    "pseudo_independence_found": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "nominal_count",
    "independent_root_count",
    "groups",
    "pseudo_independence_found"
  ],
  "type": "object"
}
