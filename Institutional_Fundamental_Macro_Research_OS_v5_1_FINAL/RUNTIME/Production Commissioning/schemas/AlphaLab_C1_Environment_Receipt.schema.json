{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "classification",
    "status",
    "created_at_utc",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "classification": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "created_at_utc": {
      "type": "string"
    },
    "checks": {
      "type": "array"
    }
  }
}
