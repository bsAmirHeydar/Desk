{
  "version": "R3_BULK_REPLAY_1.0.0",
  "default_parallel_runs": 1,
  "max_parallel_runs_without_explicit_override": 4,
  "historical_mode": "HISTORICAL_REPLAY",
  "point_in_time_required": true,
