{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab R3 Retrieval Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "analysis_cutoff_utc",
    "items",
    "gaps",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "analysis_cutoff_utc": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision_critical_gap_count": {
      "type": "integer"
    },
    "material_gap_count": {
      "type": "integer"
    },
    "created_at_utc": {
      "type": "string"
    },
    "receipt_hash": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
