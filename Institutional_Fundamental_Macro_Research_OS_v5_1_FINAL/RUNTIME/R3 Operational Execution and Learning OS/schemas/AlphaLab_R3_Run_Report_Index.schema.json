{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab R3 Run Report Index",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "machine_report_hash",
    "human_report_hash",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "machine_report_hash": {
      "type": "string"
    },
    "human_report_hash": {
      "type": "string"
    },
    "output_depth": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
