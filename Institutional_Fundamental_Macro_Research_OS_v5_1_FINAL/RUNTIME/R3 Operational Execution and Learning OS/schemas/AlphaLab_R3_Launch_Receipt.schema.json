{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab R3 Launch Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "launch_id",
    "run_ids",
    "compiled_requests",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "launch_id": {
      "type": "string"
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compiled_requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
