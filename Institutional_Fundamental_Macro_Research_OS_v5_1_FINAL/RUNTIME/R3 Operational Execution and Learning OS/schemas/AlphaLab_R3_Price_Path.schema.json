{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab R3 Price Path",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "instrument",
    "points",
    "source",
    "captured_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "instrument": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time_utc"
        ],
        "properties": {
          "time_utc": {
            "type": "string"
          },
          "open": {
            "type": [
              "number",
              "null"
            ]
          },
          "high": {
            "type": [
              "number",
              "null"
            ]
          },
          "low": {
            "type": [
              "number",
              "null"
            ]
          },
          "close": {
            "type": [
              "number",
              "null"
            ]
          },
          "bid": {
            "type": [
              "number",
              "null"
            ]
          },
          "ask": {
            "type": [
              "number",
              "null"
            ]
          },
          "mid": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string"
    },
    "captured_at_utc": {
      "type": "string"
    },
    "point_in_time_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
