{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "cases": {
      "items": {
        "$ref": "AlphaLab_R4_Certification_Case.schema.json"
      },
      "type": "array"
    },
    "certification_id": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string"
    },
    "non_claims": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile": {
      "enum": [
        "CORE",
        "FULL",
        "ENVIRONMENT"
      ]
    },
    "runtime": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "scientific_stack": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING"
      ]
    },
    "surface_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "certification_id",
    "profile",
    "status",
    "classification",
    "scientific_stack",
    "runtime",
    "cases",
    "created_at_utc"
  ],
  "type": "object"
}
