{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "detail": {},
    "hard": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIP",
        "PENDING"
      ]
    }
  },
  "required": [
    "case_id",
    "category",
    "hard",
    "status"
  ],
  "type": "object"
}
