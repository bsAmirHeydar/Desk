{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab Coverage Requirement",
  "type": "object",
  "required": [
    "schema_version",
    "requirement_id",
    "fact_family",
    "materiality",
    "applicability"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "fact_family": {
      "type": "string",
      "minLength": 1
    },
    "materiality": {
      "enum": [
        "DECISION_CRITICAL",
        "MATERIAL",
        "SUPPORTING",
        "CONTEXTUAL"
      ]
    },
    "applicability": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE"
      ]
    },
    "applicability_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
