{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab Replay Request",
  "type": "object",
  "required": [
    "schema_version",
    "source_run_id",
    "replay_mode",
    "use_frozen_snapshots",
    "lookahead_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "replay_mode": {
      "enum": [
        "HISTORICAL_REPLAY",
        "RESEARCH_REPLAY",
        "REPRODUCTION_REPLAY"
      ]
    },
    "use_frozen_snapshots": {
      "type": "boolean"
    },
    "lookahead_policy": {
      "const": "STRICT_POINT_IN_TIME"
    },
    "new_run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
