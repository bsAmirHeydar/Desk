{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab D4 V21.2 Calibration Report",
  "type": "object",
  "required": [
    "record_type",
    "calibration_id",
    "modifier_id",
    "policy_version",
    "calibration_version",
    "created_at_utc",
    "development",
    "holdout",
    "promotion_eligibility",
    "dependence",
    "tail_risk",
    "regime_stability",
    "multiple_testing",
    "chronological_split_attested",
    "execution_profiles",
    "hypothesis_family_ids"
  ],
  "properties": {
    "record_type": {
      "const": "CALIBRATION_REPORT"
    },
    "calibration_id": {
      "type": "string"
    },
    "modifier_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "hypothesis_family_id": {
      "type": "string"
    },
    "development": {
      "type": "object"
    },
    "holdout": {
      "type": "object"
    },
    "regime_stability": {
      "type": "object"
    },
    "tail_risk": {
      "type": "object"
    },
    "multiple_testing": {
      "type": "object"
    },
    "promotion_eligibility": {
      "enum": [
        "NOT_ELIGIBLE",
        "ELIGIBLE_FOR_REVIEW",
        "VALIDATION_FAILED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "calibration_version": {
      "type": "string"
    },
    "dependence": {
      "type": "object"
    },
    "chronological_split_attested": {
      "type": "boolean"
    },
    "execution_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypothesis_family_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "reference_class_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "promotion_eligibility_reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
