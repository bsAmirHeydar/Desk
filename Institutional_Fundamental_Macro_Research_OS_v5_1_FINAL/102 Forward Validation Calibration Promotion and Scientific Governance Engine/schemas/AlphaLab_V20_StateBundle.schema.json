{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaLab V20 State Bundle",
  "type": "object",
  "required": [
    "version",
    "instrument",
    "fundamental_direction",
    "d3_adjudication",
    "d4_authority_receipt",
    "final_permission"
  ],
  "properties": {
    "version": {
      "const": "20.0.0"
    },
    "instrument": {
      "enum": [
        "XAUUSD",
        "NASDAQ100",
        "SP500",
        "DJIA",
        "EURUSD",
        "USDJPY"
      ]
    },
    "fundamental_direction": {
      "enum": [
        "BULLISH",
        "BEARISH",
        "NEUTRAL",
        "UNRESOLVED"
      ]
    },
    "d3_adjudication": {
      "type": "object",
      "required": [
        "fundamental_direction",
        "final_direction",
        "pre_d3_permission",
        "final_permission",
        "d3_edge_quality"
      ],
      "properties": {
        "fundamental_direction": {
          "type": "string"
        },
        "final_direction": {
          "type": "string"
        },
        "pre_d3_permission": {
          "enum": [
            "BUY",
            "SELL",
            "NO_TRADE"
          ]
        },
        "final_permission": {
          "enum": [
            "BUY",
            "SELL",
            "NO_TRADE"
          ]
        },
        "d3_edge_quality": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "d4_authority_receipt": {
      "type": "object",
      "required": [
        "registry_version",
        "applied_promotion_ids",
        "shadow_candidate_ids"
      ],
      "properties": {
        "registry_version": {
          "type": "string"
        },
        "applied_promotion_ids": {
          "type": "array"
        },
        "shadow_candidate_ids": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "final_permission": {
      "enum": [
        "BUY",
        "SELL",
        "NO_TRADE"
      ]
    },
    "forward_observation": {
      "type": "object",
      "required": [
        "record_type",
        "record_id"
      ],
      "properties": {
        "record_type": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
