{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaLab_Surprise_State.schema.json",
  "title": "Alpha Lab V21.2 Surprise and Expectation State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectation_layers",
    "data_surprise",
    "economic_implication",
    "policy_implication",
    "asset_implication",
    "market_surprise",
    "composition_surprise",
    "revision_surprise",
    "expectation_recoverability",
    "interpretation"
  ],
  "properties": {
    "expectation_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "state",
          "source_or_reason"
        ],
        "properties": {
          "layer": {
            "enum": [
              "OFFICIAL_CONSENSUS",
              "SURVEY_DISTRIBUTION",
              "MARKET_IMPLIED",
              "WHISPER_OR_ALTERNATIVE_EXPECTATION",
              "POSITIONING_EXPECTATION",
              "OPTION_IMPLIED_EVENT_DISTRIBUTION",
              "PRIOR_TREND",
              "REVISION_EXPECTATION"
            ]
          },
          "state": {},
          "source_or_reason": {
            "type": "string"
          },
          "freshness_state": {
            "enum": [
              "FRESH",
              "STALE",
              "MIXED",
              "UNDETERMINED"
            ]
          },
          "estimate_type": {
            "enum": [
              "POINT",
              "DISTRIBUTION",
              "RANGE",
              "QUALITATIVE",
              "UNDETERMINED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "AlphaLab_Evidence_Reference.schema.json"
            }
          }
        }
      }
    },
    "market_surprise": {
      "enum": [
        "STRONGLY_BEARISH",
        "BEARISH",
        "NEUTRAL",
        "BULLISH",
        "STRONGLY_BULLISH",
        "MIXED",
        "UNDETERMINED",
        "NOT_APPLICABLE"
      ]
    },
    "composition_surprise": {
      "type": "string"
    },
    "revision_surprise": {
      "type": "string"
    },
    "expectation_recoverability": {
      "enum": [
        "FULL",
        "PARTIAL",
        "POOR",
        "UNRECOVERABLE"
      ]
    },
    "interpretation": {
      "type": "string"
    },
    "numeric_probability_used": {
      "const": false
    },
    "data_surprise": {
      "enum": [
        "STRONG_NEGATIVE",
        "NEGATIVE",
        "NEUTRAL",
        "POSITIVE",
        "STRONG_POSITIVE",
        "MIXED",
        "UNDETERMINED",
        "NOT_APPLICABLE"
      ]
    },
    "economic_implication": {
      "enum": [
        "STRONG_NEGATIVE",
        "NEGATIVE",
        "NEUTRAL",
        "POSITIVE",
        "STRONG_POSITIVE",
        "MIXED",
        "UNDETERMINED",
        "NOT_APPLICABLE"
      ]
    },
    "policy_implication": {
      "enum": [
        "STRONGLY_DOVISH",
        "DOVISH",
        "NEUTRAL",
        "HAWKISH",
        "STRONGLY_HAWKISH",
        "MIXED",
        "UNDETERMINED",
        "NOT_APPLICABLE"
      ]
    },
    "asset_implication": {
      "enum": [
        "STRONGLY_BEARISH",
        "BEARISH",
        "NEUTRAL",
        "BULLISH",
        "STRONGLY_BULLISH",
        "MIXED",
        "UNDETERMINED",
        "NOT_APPLICABLE"
      ]
    }
  }
}
