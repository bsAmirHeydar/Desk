{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaLab_Hypothesis_Set.schema.json",
  "title": "Alpha Lab V21.2 Hypothesis Tournament",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "instrument",
    "analysis_cutoff_utc",
    "active_horizon",
    "hypotheses",
    "tournament_state",
    "dominant_hypothesis_ids",
    "strongest_challenger_ids",
    "single_hypothesis_justification",
    "tournament_basis"
  ],
  "properties": {
    "version": {
      "const": "1.2.0"
    },
    "instrument": {
      "enum": [
        "XAUUSD",
        "NASDAQ100",
        "SP500",
        "DJIA",
        "EURUSD",
        "USDJPY"
      ]
    },
    "analysis_cutoff_utc": {
      "type": "string",
      "format": "date-time"
    },
    "active_horizon": {
      "enum": [
        "MICRO_0_15M",
        "SHORT_15_60M",
        "SESSION_1_6H",
        "DAILY_OPEN_TO_CLOSE",
        "MULTI_DAY_2_10D",
        "SWING_2_8W",
        "CYCLICAL",
        "STRUCTURAL"
      ]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "AlphaLab_Hypothesis.schema.json"
      }
    },
    "tournament_state": {
      "enum": [
        "DOMINANT",
        "CO_DOMINANT",
        "CONTESTED",
        "FRAGMENTED",
        "NO_CREDIBLE_DOMINANT_HYPOTHESIS",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "dominant_hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strongest_challenger_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "single_hypothesis_justification": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_critical_conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution_observations": {
      "type": "array",
      "items": {
        "$ref": "AlphaLab_Trigger_Predicate.schema.json"
      }
    },
    "tournament_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_root_count",
        "critical_contradiction_count",
        "signature_alignment",
        "regime_consistency",
        "falsifiability",
        "complexity_state"
      ],
      "properties": {
        "independent_root_count": {
          "type": "integer",
          "minimum": 0
        },
        "critical_contradiction_count": {
          "type": "integer",
          "minimum": 0
        },
        "signature_alignment": {
          "enum": [
            "STRONG",
            "MODERATE",
            "WEAK",
            "CONTESTED",
            "UNDETERMINED"
          ]
        },
        "regime_consistency": {
          "enum": [
            "PASS",
            "CONTESTED",
            "FAIL",
            "UNDETERMINED"
          ]
        },
        "falsifiability": {
          "enum": [
            "HIGH",
            "MODERATE",
            "LOW",
            "UNDETERMINED"
          ]
        },
        "complexity_state": {
          "enum": [
            "LEAN",
            "PROPORTIONATE",
            "COMPLEX_BUT_JUSTIFIED",
            "OVERCOMPLEX",
            "UNDETERMINED"
          ]
        },
        "root_count_mode": {
          "enum": [
            "DERIVED_COMPLETE",
            "DERIVED_PARTIAL",
            "MANUAL_WITH_DISCLOSURE"
          ]
        },
        "derived_root_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "derived_critical_contradiction_count": {
          "type": "integer",
          "minimum": 0
        },
        "dominance_audit_state": {
          "enum": [
            "PASS",
            "CONTESTED",
            "INSUFFICIENT_EVIDENCE",
            "MANUAL_REVIEW"
          ]
        }
      }
    },
    "evidence_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "verified_root_count",
          "decision_critical_contradictions",
          "missing_decision_critical_evidence",
          "evidence_quality",
          "causal_coherence"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "verified_root_count": {
            "type": "integer",
            "minimum": 0
          },
          "decision_critical_contradictions": {
            "type": "integer",
            "minimum": 0
          },
          "missing_decision_critical_evidence": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_quality": {
            "type": "string"
          },
          "causal_coherence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
