{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaLab_PreMortem.schema.json",
  "title": "Alpha Lab V21.1 Decision Pre-Mortem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumed_action",
    "failure_paths",
    "unmonitorable_decision_critical_risk",
    "coverage_justification"
  ],
  "properties": {
    "assumed_action": {
      "enum": [
        "BUY",
        "SELL",
        "NO_TRADE",
        "HOLD"
      ]
    },
    "failure_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "mechanism",
          "monitorable",
          "response",
          "early_warning_trigger"
        ],
        "properties": {
          "failure_id": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "monitorable": {
            "type": "boolean"
          },
          "response": {
            "type": "string"
          },
          "early_warning_trigger": {
            "$ref": "AlphaLab_Trigger_Predicate.schema.json"
          }
        }
      }
    },
    "unmonitorable_decision_critical_risk": {
      "type": "boolean"
    },
    "unmonitorable_risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_justification": {
      "type": "string",
      "minLength": 1
    }
  }
}
