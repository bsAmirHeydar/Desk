{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaLab_Hypothesis.schema.json",
  "title": "Alpha Lab V21 Causal Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "title",
    "family",
    "mechanism",
    "target_horizons",
    "supporting_evidence",
    "contradicting_evidence",
    "missing_evidence",
    "expected_leaders",
    "expected_market_signatures",
    "confirmation_triggers",
    "invalidation_triggers",
    "plausibility_band",
    "evidence_quality",
    "causal_coherence"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "POLICY_REACTION",
        "INFLATION",
        "GROWTH",
        "LABOR",
        "EARNINGS_CASHFLOW",
        "FISCAL_SUPPLY",
        "CREDIT",
        "FX_RELATIVE_POLICY",
        "PHYSICAL_BALANCE",
        "FUNDING_LIQUIDITY",
        "POSITIONING_FLOW",
        "MECHANICAL",
        "IDIOSYNCRATIC",
        "GEOPOLITICAL",
        "UNKNOWN_OTHER"
      ]
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "root_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_horizons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MICRO_0_15M",
          "SHORT_15_60M",
          "SESSION_1_6H",
          "DAILY_OPEN_TO_CLOSE",
          "MULTI_DAY_2_10D",
          "SWING_2_8W",
          "CYCLICAL",
          "STRUCTURAL"
        ]
      }
    },
    "direction_by_horizon": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "STRONGLY_BEARISH",
          "BEARISH",
          "NEUTRAL",
          "BULLISH",
          "STRONGLY_BULLISH",
          "MIXED",
          "UNDETERMINED"
        ]
      }
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_leaders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_market_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmation_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regime_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reflexive_loops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plausibility_band": {
      "enum": [
        "DOMINANT",
        "COMPETITIVE",
        "SECONDARY",
        "WEAK",
        "UNSUPPORTED",
        "UNDETERMINED"
      ]
    },
    "evidence_quality": {
      "enum": [
        "VERY_LOW",
        "LOW",
        "MODERATE",
        "HIGH",
        "VERY_HIGH",
        "UNDETERMINED"
      ]
    },
    "causal_coherence": {
      "enum": [
        "VERY_LOW",
        "LOW",
        "MODERATE",
        "HIGH",
        "VERY_HIGH",
        "UNDETERMINED"
      ]
    },
    "materiality": {
      "enum": [
        "DECISION_CRITICAL",
        "MATERIAL",
        "SUPPORTING",
        "CONTEXTUAL"
      ]
    },
    "outside_fundamental_strategy": {
      "type": "boolean"
    }
  }
}
