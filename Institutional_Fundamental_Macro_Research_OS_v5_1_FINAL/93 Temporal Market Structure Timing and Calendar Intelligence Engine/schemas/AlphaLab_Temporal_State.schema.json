{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alpha Lab V15 Temporal State",
  "type": "object",
  "required": [
    "generated_at_utc",
    "symbol",
    "temporal_state",
    "edge_action",
    "valid_until_utc",
    "next_review_utc",
    "confidence"
  ],
  "properties": {
    "generated_at_utc": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "temporal_state": {
      "type": "string"
    },
    "dominant_clock": {
      "type": "object"
    },
    "competing_clocks": {
      "type": "array"
    },
    "temporal_forces": {
      "type": "array"
    },
    "edge_action": {
      "enum": [
        "NO_CHANGE",
        "SHORTEN_VALIDITY",
        "EARLY_REVIEW",
        "VETO_NEW_ENTRY",
        "TEMPORAL_FORCE_OVERLAY",
        "FRAGMENTED"
      ]
    },
    "is_true_veto": {
      "type": "boolean"
    },
    "valid_until_utc": {
      "type": "string"
    },
    "next_review_utc": {
      "type": "string"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "missing_data": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
