{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P09 Hypothesis",
  "type": "object",
  "required": [
    "record_type",
    "hypothesis_id",
    "failure_family",
    "candidate_family",
    "status",
    "authority"
  ],
  "properties": {
    "record_type": {
      "const": "P09_RESEARCH_HYPOTHESIS"
    },
    "hypothesis_id": {
      "type": "string"
    },
    "failure_family": {
      "type": "string"
    },
    "candidate_family": {
      "type": "string"
    },
    "status": {
      "enum": [
        "RESEARCH_PROPOSAL",
        "OPERATOR_REVIEW_REQUIRED"
      ]
    },
    "authority": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
