    "analysis_admission",
    "reasoning_ledger",
    "pressure_planes",
    "model_quality",
    "shadow_decision"
  ],
  "properties": {
    "record_type": {
      "const": "AD_V3_P03_CAUSAL_BRAIN_RECEIPT"
    },
    "analysis_admission": {
      "enum": [
        "PASS",
        "DEGRADED",
        "BLOCKED"
      ]
    },
    "production_direction_authority_granted": {
      "const": false
    },
    "production_trade_permission_authority_granted": {
      "const": false
    },
    "handoff_integrity": {
      "type": "object"
    }
  }
}
