  "rev_3_2_3_hardening": [
    "BLS CPI/PPI/employment/JOLTS facts use one official Public Data API POST batch instead of 403-prone web pages.",
    "Federal Reserve Broad/AFE/EME dollar facts use dedicated H.10 daily index pages.",
    "US retail sales uses the Federal Reserve Bank of St. Louis public CSV republisher and remains PUBLIC_PROXY.",
    "US 5Y5Y forward inflation is derived from Treasury breakeven observations instead of a fragile web page.",
    "CME gold price/open interest/curve and Fed-funds futures use best-effort CME-hosted delayed web JSON with official Daily Bulletin PDFs as fallback.",
    "PBoC and SGE TLS failures have official-government / WGC proxy fallbacks that remain explicitly proxy-labelled.",
    "INR affordability uses official RBI USDINR only as a PUBLIC_PROXY input, never as a complete affordability measure."
  ],
  "rev_3_2_4_hardening": [
    "US_RETAIL_SALES now prefers the direct current U.S. Census Bureau sales release; FRED remains fallback only.",
    "INR_GOLD_AFFORDABILITY now prefers Federal Reserve H.10 Indian Rupee rates and remains an explicit affordability proxy.",
    "INDIA_IMPORT_DUTY_TAX now prefers current Government of India PIB policy communication and remains PUBLIC_PROXY because it is not a CBIC legal tariff table.",
    "The historical 6% India duty baseline is carried only as provenance-tagged context and is never asserted as a newly verified legal rate.",
