{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AD-V3-P07 Context Cache Entry",
  "type": "object",
  "required": [
    "source_id",
    "acquired_at",
    "body_sha256",
    "source_contract_sha256",
    "extractor_sha256"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "acquired_at": {
      "type": "string"
    },
    "economic_timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extractor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "next_publication_utc": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
