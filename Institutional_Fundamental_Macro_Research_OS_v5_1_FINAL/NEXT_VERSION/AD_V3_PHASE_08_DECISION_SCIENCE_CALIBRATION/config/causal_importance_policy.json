{
  "schema_version": "1.1.0",
  "phase": "AD-V3-P08",
  "method": "R02_ROOT_X_HORIZON_X_GOVERNED_REGIME_MATRIX",
  "states": [
    "UNKNOWN",
    "BACKGROUND",
    "SECONDARY",
    "PRIMARY",
    "SYSTEMIC"
  ],
  "rank": {
    "UNKNOWN": 0,
    "BACKGROUND": 1,
    "SECONDARY": 2,
    "PRIMARY": 3,
    "SYSTEMIC": 4
  },
  "rules": [
    {
      "if": "resolved current root has at least one LIVE_KERNEL evidence fact with current horizon authority",
      "importance": "PRIMARY"
    },
    {
      "if": "resolved current root is supported only by CONTEXT_CACHE evidence",
      "importance": "SECONDARY"
    },
    {
      "if": "resolved current root is supported only by ESCALATION evidence",
      "importance": "CONDITIONAL"
    },
    {
      "if": "root has background bias but no current additive direction",
      "importance": "BACKGROUND"
    },
    {
      "if": "root has no resolved current or background state",
      "importance": "UNKNOWN"
    }
  ],
  "root_ids_are_not_manually_ranked": true,
  "llm_cannot_change_importance": true,
  "legacy_evidence_tier_rules_retired_by": "AD-V3.1-R02",
  "root_ids_are_now_horizon_ranked": true
}