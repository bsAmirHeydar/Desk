{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R02 Dominance Robustness",
  "type": "object",
  "required": [
    "robustness",
    "model_sensitivity",
    "variants",
    "is_probability"
  ],
  "properties": {
    "robustness": {
      "enum": [
        "ROBUST",
        "MOSTLY_ROBUST",
        "MODEL_SENSITIVE",
        "UNSTABLE",
        "NOT_APPLICABLE"
      ]
    },
    "model_sensitivity": {
      "enum": [
        "LOW",
        "ELEVATED",
        "HIGH",
        "NOT_APPLICABLE"
      ]
    },
    "variants": {
      "type": "array"
    },
    "is_probability": {
      "const": false
    }
  },
  "additionalProperties": true
}
