{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_type",
    "commitment_id",
    "status",
    "receipt_hash"
  ],
  "properties": {
    "record_type": {
      "const": "P08_MATURITY_RECEIPT"
    },
    "status": {
      "enum": [
        "MATURE_LINKED",
        "UNSCORABLE",
        "COVERAGE_INSUFFICIENT",
        "PROFILE_REQUIRED"
      ]
    }
  },
  "additionalProperties": true
}
