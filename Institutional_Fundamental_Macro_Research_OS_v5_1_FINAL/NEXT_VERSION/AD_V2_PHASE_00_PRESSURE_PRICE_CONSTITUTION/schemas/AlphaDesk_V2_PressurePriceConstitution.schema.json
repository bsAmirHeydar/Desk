{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaDesk_V2_PressurePriceConstitution.schema.json",
  "title": "Alpha Desk V2 Phase 00 Pressure/Price Constitution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "constitution_id",
    "status",
    "pressure",
    "target_price",
    "audit_callback",
    "consumption",
    "latent_state",
    "execution",
    "frozen_record"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "constitution_id": {
      "const": "AD-V2-P00-PRESSURE-PRICE"
    },
    "status": {
      "const": "SHADOW_ONLY"
    },
    "baseline": {
      "type": "object"
    },
    "pressure": {
      "type": "object",
      "required": [
        "owner",
        "target_price_direct_authority",
        "target_price_may_change_pressure_directly",
        "reestimate_only_on_reason_codes",
        "forbidden_reason_codes"
      ],
      "properties": {
        "owner": {
          "const": "MODULE_89"
        },
        "target_price_direct_authority": {
          "const": false
        },
        "target_price_may_change_pressure_directly": {
          "const": false
        },
        "target_price_may_lower_pressure_confidence_directly": {
          "const": false
        },
        "target_price_may_lower_model_completeness_confidence": {
          "const": true
        },
        "reestimate_only_on_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "target_price": {
      "type": "object",
      "required": [
        "owner",
        "allowed_roles",
        "forbidden_roles"
      ],
      "properties": {
        "owner": {
          "const": "TRANSMISSION_DIAGNOSTIC_ONLY"
        },
        "allowed_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "audit_callback": {
      "type": "object",
      "required": [
        "path",
        "direct_price_to_pressure_edge"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "direct_price_to_pressure_edge": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "consumption": {
      "type": "object",
      "required": [
        "driver_consumption_separate_from_price_consumption",
        "target_price_distance_sufficient_for_driver_consumption"
      ],
      "properties": {
        "driver_consumption_separate_from_price_consumption": {
          "const": true
        },
        "target_price_distance_sufficient_for_driver_consumption": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "latent_state": {
      "type": "object",
      "required": [
        "phase00_authority",
        "unreleased_pressure_probability_allowed",
        "ordinal_language_allowed",
        "price_shape_alone_can_confirm_absorption",
        "price_shape_alone_can_confirm_liquidity_sweep",
        "price_shape_alone_can_confirm_institutional_accumulation",
        "epistemic_classes"
      ],
      "properties": {
        "phase00_authority": {
          "const": "RESERVED_NOT_IMPLEMENTED"
        },
        "unreleased_pressure_probability_allowed": {
          "const": false
        },
        "ordinal_language_allowed": {
          "const": true
        },
        "price_shape_alone_can_confirm_absorption": {
          "const": false
        },
        "price_shape_alone_can_confirm_liquidity_sweep": {
          "const": false
        },
        "price_shape_alone_can_confirm_institutional_accumulation": {
          "const": false
        },
        "epistemic_classes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "items": {
            "enum": [
              "OBSERVED",
              "SUPPORTED_INFERENCE",
              "PLAUSIBLE_HYPOTHESIS",
              "UNRESOLVED"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "price_can_modulate_permission",
        "technical_can_modulate_timing",
        "technical_can_change_fundamental_pressure",
        "high_pressure_implies_trade"
      ],
      "properties": {
        "price_can_modulate_permission": {
          "const": true
        },
        "technical_can_modulate_timing": {
          "const": true
        },
        "technical_can_change_fundamental_pressure": {
          "const": false
        },
        "high_pressure_implies_trade": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "frozen_record": {
      "type": "object",
      "required": [
        "future_outcome_can_rewrite_historical_pressure",
        "d4_can_calibrate_future_mapping"
      ],
      "properties": {
        "future_outcome_can_rewrite_historical_pressure": {
          "const": false
        },
        "d4_can_calibrate_future_mapping": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  }
}
