{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaLab_Funding_Plumbing_State.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "instrument",
    "as_of_utc",
    "authority_mode",
    "coverage_state",
    "stress_state",
    "evidence_ids",
    "permission_effect_v18"
  ],
  "properties": {
    "instrument": {
      "type": "string"
    },
    "as_of_utc": {
      "type": "string"
    },
    "authority_mode": {
      "const": "CANONICAL_SHADOW"
    },
    "coverage_state": {
      "enum": [
        "FULL_PUBLIC",
        "PARTIAL_PUBLIC",
        "LICENSED_REQUIRED",
        "UNAVAILABLE",
        "UNDETERMINED"
      ]
    },
    "monetary_liquidity": {
      "enum": [
        "EASY",
        "NORMAL",
        "TIGHT",
        "STRESSED",
        "DISLOCATED",
        "UNKNOWN"
      ]
    },
    "funding_liquidity": {
      "enum": [
        "EASY",
        "NORMAL",
        "TIGHT",
        "STRESSED",
        "DISLOCATED",
        "UNKNOWN"
      ]
    },
    "collateral_state": {
      "enum": [
        "EASY",
        "NORMAL",
        "TIGHT",
        "STRESSED",
        "DISLOCATED",
        "UNKNOWN"
      ]
    },
    "dealer_capacity": {
      "enum": [
        "EASY",
        "NORMAL",
        "TIGHT",
        "STRESSED",
        "DISLOCATED",
        "UNKNOWN"
      ]
    },
    "stress_state": {
      "enum": [
        "EASY",
        "NORMAL",
        "TIGHT",
        "STRESSED",
        "DISLOCATED",
        "UNKNOWN"
      ]
    },
    "active_settlement_pressures": {
      "type": "array"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission_effect_v18": {
      "const": "NONE"
    }
  }
}
