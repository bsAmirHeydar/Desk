{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlphaLab_D3_Integration_Vector.schema.json",
  "title": "Alpha Lab D3 Integration Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "science",
    "causal_channel",
    "alignment_to_fundamental",
    "obstruction_class",
    "materiality",
    "evidence_grade",
    "root_id"
  ],
  "properties": {
    "science": {
      "enum": [
        "POSITIONING_OWNERSHIP",
        "ACTUAL_FLOW",
        "FUNDING_PLUMBING",
        "INSTITUTIONAL_MECHANICS",
        "MARKET_CAPACITY"
      ]
    },
    "causal_channel": {
      "type": "string",
      "minLength": 1
    },
    "alignment_to_fundamental": {
      "enum": [
        "SUPPORTIVE",
        "NEUTRAL",
        "OPPOSING",
        "NON_DIRECTIONAL",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "obstruction_class": {
      "enum": [
        "NONE",
        "FRICTION",
        "DELAY",
        "TRANSMISSION_BREAK",
        "EXECUTION_BLOCK",
        "UNKNOWN"
      ]
    },
    "materiality": {
      "enum": [
        "DECISION_CRITICAL",
        "MATERIAL",
        "SUPPORTING",
        "CONTEXTUAL"
      ]
    },
    "evidence_grade": {
      "enum": [
        "DIRECT_IDENTIFIED",
        "OFFICIAL_OR_EXCHANGE",
        "DERIVED_WITH_LINEAGE",
        "PUBLIC_PROXY",
        "MODEL_INFERENCE",
        "UNKNOWN"
      ]
    },
    "root_id": {
      "type": "string",
      "minLength": 1
    },
    "persistence": {
      "type": "string"
    },
    "decision_critical_unknown": {
      "type": "boolean"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Legacy ordinal confidence metadata only; not a calibrated predictive probability in V21."
    },
    "notes": {
      "type": "string"
    },
    "evidence_confidence_band": {
      "enum": [
        "VERY_LOW",
        "LOW",
        "MODERATE",
        "HIGH",
        "VERY_HIGH",
        "UNDETERMINED"
      ]
    },
    "horizon": {
      "enum": [
        "MICRO_0_15M",
        "SHORT_15_60M",
        "SESSION_1_6H",
        "DAILY_OPEN_TO_CLOSE",
        "MULTI_DAY_2_10D",
        "SWING_2_8W",
        "CYCLICAL",
        "STRUCTURAL"
      ]
    },
    "channel_id": {
      "type": "string"
    },
    "fragility_state": {
      "type": "string"
    },
    "crowding_state": {
      "type": "string"
    }
  }
}
